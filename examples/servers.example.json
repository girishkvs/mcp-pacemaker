{
  "filesystem": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
  },
  "github": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-github"],
    "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "REPLACE_WITH_YOUR_PAT" }
  },
  "example-http-static-token": {
    "type": "http",
    "url": "https://example.com/mcp",
    "auth": { "type": "env", "var": "EXAMPLE_TOKEN" }
  },
  "example-http-cli-token": {
    "type": "http",
    "url": "https://your-service.example.com/mcp",
    "auth": {
      "type": "command",
      "command": "az account get-access-token --resource api://your-resource-id --query accessToken -o tsv",
      "refreshMinutes": 50
    },
    "headers": { "x-example-header": "value" }
  },
  "example-http-no-auth": {
    "type": "http",
    "url": "https://open.example.com/mcp",
    "auth": { "type": "none" }
  }
}
